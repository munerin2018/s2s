# Normalise to LF in the repository. Without this, files committed from Windows
# arrive with CRLF on the Linux CI runners, where shell scripts and anything
# comparing bytes stops working.
* text=auto eol=lf

*.png binary
*.jpg binary
*.apk binary
*.exe binary
*.ico binary

# Batch files must keep CRLF: cmd.exe mis-parses labels and `goto` in a .bat
# with LF endings, and gradlew.bat is full of both.
*.bat text eol=crlf
*.cmd text eol=crlf
