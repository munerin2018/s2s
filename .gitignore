# dependencies and build output
node_modules/
packages/ui/dist/
rust/s2s-peer/target/
apps/desktop/release/

# The Android project is committed: it carries release configuration
# (signing hookup, versioning, launcher icons) that a regenerate would lose.
# Its own .gitignore keeps build output and local.properties out.
# The iOS project is still generated - `npx cap add ios`, and only on a Mac.
apps/mobile/ios/
*.jks
*.keystore
keystore.properties
apps/mobile/www/

# peer data directories: these hold account private keys
.s2s-peer/
.peer-*/
.s2s/
**/identity.json
**/events.jsonl
**/blobs/

# scratch
.tmp/
*.log
.env
.DS_Store
Thumbs.db

# Google Play service account key and anything else secret-shaped
.secrets/

# personal notes and local workflow helpers, not part of the project
はじめに.md
scripts/setup.ps1

# release artifacts built by scripts/publish.ps1
release/
.tmp2/
.tmp3/
.demo-peer/
